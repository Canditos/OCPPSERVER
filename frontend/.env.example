# ── Local development (deixar vazio = usa o proxy do Vite em localhost:8000) ──
VITE_API_URL=
VITE_WS_URL=

# ── Produção ──────────────────────────────────────────────────────────────────
# Substitui YOUR-BACKEND pelo URL do teu serviço no Render/Railway/Fly.io
# VITE_API_URL=https://YOUR-BACKEND.onrender.com
# VITE_WS_URL=wss://YOUR-BACKEND.onrender.com

# ── Nota sobre o charger (VersiCharge) ───────────────────────────────────────
# Em produção, configura o charger para ligar a:
#   wss://YOUR-BACKEND.onrender.com/ocpp/{charge_point_id}
# Em desenvolvimento local:
#   ws://localhost:8000/ocpp/{charge_point_id}
